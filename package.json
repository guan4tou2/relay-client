{
  "name": "socks5-client",
  "productName": "RelayClient",
  "version": "1.3.9",
  "description": "Windows 圖形化 proxychains：串接 SOCKS/HTTP 代理、指定程式走代理、斷線保護（SOCKS5 / SOCKS4 / HTTP / HTTPS）",
  "main": "main.js",
  "author": {
    "name": "guantou",
    "email": "mole30608@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "jest --runInBand",
    "make-icon": "node scripts/make-icon.js",
    "pack": "npm run make-icon && electron-builder --win --dir",
    "dist": "npm run make-icon && electron-builder --win",
    "release": "npm run make-icon && electron-builder --win --publish always",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.4"
  },
  "jest": {
    "testTimeout": 15000
  },
  "build": {
    "appId": "com.guantou.relayclient",
    "productName": "RelayClient",
    "copyright": "Copyright © 2026 guantou",
    "publish": [
      {
        "provider": "github",
        "owner": "guan4tou2",
        "repo": "relay-client"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "assets/tray.png",
      "assets/tray-active.png",
      "assets/icon.png"
    ],
    "afterPack": "scripts/afterPack.js",
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!test/**",
      "!.claude/**",
      "!scripts/**",
      "!engine/**",
      "!sb/**",
      "!sb.zip",
      "!*.zip",
      "!dist/**",
      "!build/**",
      "!docs/**",
      "!.github/**",
      "!**/*.test.js",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.ts",
      "!**/{test,tests,__tests__,example,examples,docs,doc,.github,.vscode}/**",
      "!**/{CHANGELOG,CHANGES,HISTORY,AUTHORS,CONTRIBUTORS}*",
      "!**/*.min.js.map",
      "!**/tsconfig.json",
      "!**/.eslintrc*",
      "!eslint.config.js",
      "!.gitignore",
      "!package-lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "engine/sing-box.exe",
          "to": "engine/sing-box.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RelayClient",
      "artifactName": "RelayClient-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "RelayClient-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "artifactName": "RelayClient-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "RelayClient",
          "Comment": "SOCKS/HTTP 代理串接與分流",
          "Categories": "Network;"
        }
      },
      "extraResources": [
        {
          "from": "engine/sing-box",
          "to": "engine/sing-box"
        }
      ]
    }
  }
}
